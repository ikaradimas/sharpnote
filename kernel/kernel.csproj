<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Memory footprint: the kernel is a long-lived process that accumulates script
         state (see tasks/kernel-memory-redesign.md). Workstation GC keeps the base
         footprint low, and RetainVM=false returns freed segments to the OS so RSS falls
         after large allocations are collected instead of the runtime hoarding them. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- GC.ConserveMemory (0–9): trade some GC CPU for a smaller, more aggressively
         decommitted heap. A moderate value keeps working-set closer to live-heap size
         for a workload that alternates heavy allocation bursts with idle time. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" Trim="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude test project files from the main kernel compilation -->
    <Compile Remove="kernel.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="4.9.2" />
    <PackageReference Include="NuGet.Protocol" Version="6.*" />
    <PackageReference Include="NuGet.Resolver" Version="6.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <!-- Override the transitive SQLitePCLRaw (2.1.11) pulled by EF Core Sqlite: 2.1.11's
         bundled SQLite has a known high-severity vuln (NU1903 / GHSA-2m69-gcr7-jv3q).
         2.1.12 is an API-compatible patch that ships the fixed native library. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.*" />
    <PackageReference Include="StreamJsonRpc" Version="2.*" />
  </ItemGroup>

</Project>
